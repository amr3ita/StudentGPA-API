@model Student_GPA.ViewModels.CourseFormViewModel

@{
    ViewData["Title"] = "Edit Course";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0"><i class="fas fa-edit me-2"></i> Edit Course</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="CourseCode" class="form-label fw-bold">Course Code (Auto-generated)</label>
                        <input asp-for="CourseCode" class="form-control bg-light text-muted" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CourseName" class="form-label fw-bold">Course Name</label>
                        <input asp-for="CourseName" class="form-control" />
                        <span asp-validation-for="CourseName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreditHours" class="form-label fw-bold">Credit Hours (1 to 3)</label>
                        <input asp-for="CreditHours" type="number" min="1" max="3" class="form-control" />
                        <span asp-validation-for="CreditHours" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-sync-alt me-1"></i> Update Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>