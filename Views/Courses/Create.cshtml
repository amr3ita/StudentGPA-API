@model Student_GPA.ViewModels.CourseFormViewModel

@{
    ViewData["Title"] = "Add Course";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i> Add New Course</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="CourseName" class="form-label fw-bold">Course Name</label>
                        <input asp-for="CourseName" class="form-control" placeholder="e.g. Data Structures" />
                        <span asp-validation-for="CourseName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreditHours" class="form-label fw-bold">Credit Hours (1 to 3)</label>
                        <input asp-for="CreditHours" type="number" min="1" max="3" class="form-control" placeholder="Enter hours (1, 2, or 3)" />
                        <span asp-validation-for="CreditHours" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back
                        </a>
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="fas fa-save me-1"></i> Save Course
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>