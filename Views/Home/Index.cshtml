@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Welcome Section -->
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border-0 text-center">
    <div class="container-fluid py-3">
        <div class="mb-3">
            <i class="fas fa-graduation-cap text-success fa-3x"></i>
        </div>
        <h1 class="display-5 fw-bold text-success">Student GPA Management System</h1>
        <p class="col-md-8 fs-5 mx-auto text-muted mt-3">
            A comprehensive academic tracking platform built with ASP.NET Core MVC. Manage students, dynamic courses, semesters, and automated GPA calculations seamlessly.
        </p>
        <div class="mt-4">
            <a asp-controller="Students" asp-action="Index" class="btn btn-primary-custom btn-lg px-4 me-2 shadow-sm">
                <i class="fas fa-users me-2"></i> Manage Students
            </a>
            <a asp-controller="Semesters" asp-action="Index" class="btn btn-outline-success btn-lg px-4 shadow-sm">
                <i class="fas fa-calendar-alt me-2"></i> Manage Semesters
            </a>
        </div>
    </div>
</div>

<!-- Quick Features Cards -->
<div class="row g-4 py-2">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-3 mb-3">
                    <i class="fas fa-user-graduate fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Students & Transcripts</h5>
                <p class="text-muted small">Register new students, track their academic history, and review cumulative and semester GPA calculations instantly.</p>
                <a asp-controller="Students" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Go to Students</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-3 mb-3">
                    <i class="fas fa-book fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Course Catalog</h5>
                <p class="text-muted small">Manage available curriculum courses, assign strict credit hours (1 to 3), and handle prerequisite logic effortlessly.</p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Go to Courses</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-3 mb-3">
                    <i class="fas fa-calendar-check fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark">Semesters & Registration</h5>
                <p class="text-muted small">Control active academic terms with single-active-semester rules and manage student course registration securely.</p>
                <a asp-controller="Semesters" asp-action="Index" class="btn btn-sm btn-outline-success mt-2">Go to Semesters</a>
            </div>
        </div>
    </div>
</div>