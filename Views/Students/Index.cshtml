@model List<Student_GPA.ViewModels.StudentFormViewModel>

@{
    ViewData["Title"] = "Students List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-graduate text-success"></i> Students Management</h2>
    <a asp-action="Create" class="btn btn-primary-custom shadow-sm">
        <i class="fas fa-user-plus me-1"></i> Add New Student
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-success text-success">
                <tr>
                    <th class="py-3 ps-3">Student Code</th>
                    <th class="py-3">Full Name</th>
                    <th class="py-3 text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td class="ps-3"><span class="badge bg-light text-dark border">@student.StudentCode</span></td>
                            <td class="fw-bold text-secondary">@student.FullName</td>
                            <td class="text-end pe-3">
                                <a asp-controller="Enrollments" asp-action="Transcript" asp-route-studentId="@student.Id" class="btn btn-sm btn-outline-info me-1">
                                    <i class="fas fa-graduation-cap"></i> Transcript
                                </a>
                                <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-success me-1">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@student.Id)">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                                <form id="delete-form-@student.Id" asp-action="Delete" asp-route-id="@student.Id" method="post" style="display:none;"></form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-5">
                            <i class="fas fa-folder-open fa-2x mb-2 text-success opacity-50"></i>
                            <p class="mb-0">No students found. Add some students to get started!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // إعداد الـ Toast لتظهر فوق على اليمين وتختفي أوتوماتيك
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        // رسالة النجاح
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                Toast.fire({
                    icon: 'success',
                    title: '@TempData["SuccessMessage"]'
                });
                </text>
        }

        // دالة تأكيد الحذف (تفضل في المنتصف لأنها عملية حساسة ومهمة للتأكيد)
        function confirmDelete(studentId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('delete-form-' + studentId).submit();
                }
            })
        }
    </script>
}