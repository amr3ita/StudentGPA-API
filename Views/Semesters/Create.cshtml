@model Student_GPA.ViewModels.SemesterFormViewModel

@{
    ViewData["Title"] = "Add Semester";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0"><i class="fas fa-calendar-plus me-2"></i> Add New Semester</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="SemesterName" class="form-label fw-bold">Semester Name</label>
                        <input asp-for="SemesterName" class="form-control" placeholder="e.g. Fall 2026" />
                        <span asp-validation-for="SemesterName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                        <label class="form-check-label fw-bold text-secondary" for="isActiveCheck">
                            Set as Active Semester (Open for registration right now)
                        </label>
                        <div class="form-text small text-muted">Note: Activating this will automatically close any other open semester.</div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back
                        </a>
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="fas fa-save me-1"></i> Save Semester
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>