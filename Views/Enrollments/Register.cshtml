@model List<Student_GPA.ViewModels.CourseSelectionViewModel>

@{
    ViewData["Title"] = "Course Registration";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-clipboard-list me-2"></i> Register Courses for @ViewBag.StudentName</h5>
                <span class="badge bg-light text-success px-3 py-2 fw-bold">Active Semester: @ViewBag.ActiveSemesterName</span>
            </div>

            <div class="card-body p-4">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    </div>
                }

                @if (Model != null && Model.Any())
                {
                    <form asp-action="Register" method="post" id="registrationForm">
                        <input type="hidden" name="studentId" value="@ViewBag.StudentId" />

                        <!-- Counter الـ ساعات الحي -->
                        <div class="alert alert-success d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <i class="fas fa-info-circle me-1"></i> Select courses (Min: 12 Hours, Max: 18 Hours)
                            </div>
                            <div class="fw-bold fs-5">
                                Selected Hours: <span id="selectedHoursCount" class="badge bg-dark">0</span> / 18
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;" class="text-center">Select</th>
                                        <th>Course Code</th>
                                        <th>Course Name</th>
                                        <th>Credit Hours</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in Model)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input type="checkbox" name="selectedCourseIds" value="@course.Id" data-hours="@course.CreditHours" class="form-check-input course-checkbox" style="transform: scale(1.3);" />
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@course.CourseCode</span></td>
                                            <td class="fw-bold text-secondary">@course.CourseName</td>
                                            <td><span class="badge bg-success bg-opacity-75">@course.CreditHours Hours</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Transcript" asp-route-studentId="@ViewBag.StudentId" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Back to Transcript
                            </a>
                            <!-- زرار الـ Submit بيفضل Disabled لحد ما يعدي 12 ساعة -->
                            <button type="submit" id="submitBtn" class="btn btn-primary-custom" disabled>
                                <i class="fas fa-check-circle me-1"></i> Submit Registration
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-book-open fa-2x mb-2 text-success opacity-50"></i>
                        <p class="mb-0">No available courses left for registration (Student has taken all courses).</p>
                        <div class="mt-3">
                            <a asp-action="Transcript" asp-route-studentId="@ViewBag.StudentId" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Back to Transcript
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkboxes = document.querySelectorAll(".course-checkbox");
            const hoursCountSpan = document.getElementById("selectedHoursCount");
            const submitBtn = document.getElementById("submitBtn");

            function updateHours() {
                let totalHours = 0;
                checkboxes.forEach(cb => {
                    if (cb.checked) {
                        totalHours += parseInt(cb.getAttribute("data-hours")) || 0;
                    }
                });

                hoursCountSpan.textContent = totalHours;

                // التحقق من الحد الأدنى (12) والحد الأقصى (18)
                if (totalHours >= 12 && totalHours <= 18) {
                    submitBtn.removeAttribute("disabled");
                    hoursCountSpan.className = "badge bg-success";
                } else {
                    submitBtn.setAttribute("disabled", "true");
                    if (totalHours > 18) {
                        hoursCountSpan.className = "badge bg-danger";
                    } else {
                        hoursCountSpan.className = "badge bg-dark";
                    }
                }

                // منع اختيار مواد جديدة لو الـ Selection الحالي هيعدي 18 ساعة
                checkboxes.forEach(cb => {
                    if (!cb.checked) {
                        let courseHours = parseInt(cb.getAttribute("data-hours")) || 0;
                        if (totalHours + courseHours > 18) {
                            cb.disabled = true;
                            cb.closest("tr").style.opacity = "0.5";
                        } else {
                            cb.disabled = false;
                            cb.closest("tr").style.opacity = "1";
                        }
                    }
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener("change", updateHours);
            });

            updateHours();
        });
    </script>
}