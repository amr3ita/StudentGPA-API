<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student GPA Management</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* لمسات خضارية هادئة مريحة للعين */
        :root {
            --primary-green: #198754;
            --soft-green-bg: #f4f9f5;
        }

        body {
            background-color: var(--soft-green-bg) !important;
        }

        .navbar-custom {
            background-color: #145c32 !importanT; 
        }

        .btn-primary-custom {
            background-color: #198754;
            border-color: #198754;
            color: white;
        }

            .btn-primary-custom:hover {
                background-color: #146c43;
                border-color: #146c43;
                color: white;
            }

        .card-header-custom {
            background-color: #e8f5e9 !important;
            color: #1b5e20 !important;
            font-weight: bold;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar (أخضر هادئ) -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">🌿 GPA System</a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-white" asp-controller="Students" asp-action="Index">
                        <i class="fas fa-users me-1"></i> Students
                    </a>
                    <a class="nav-link text-white ms-3" asp-controller="Courses" asp-action="Index">
                        <i class="fas fa-book me-1"></i> Courses
                    </a>
                    <a class="nav-link text-white ms-3" asp-controller="Semesters" asp-action="Index">
                        <i class="fas fa-calendar-alt me-1"></i> Semesters
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1 container my-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-top footer text-muted bg-white py-3 shadow-sm mt-auto">
        <div class="container text-center small text-success">
            &copy; 2026 - Student GPA Management System 🌿
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>